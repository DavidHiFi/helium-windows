--- a/ui/views/win/hwnd_message_handler.cc
+++ b/ui/views/win/hwnd_message_handler.cc
@@ -1792,8 +1792,15 @@
   // through, but that isn't the case when using Direct3D to draw transparent
   // windows. So we route translucent windows throught to the delegate to
   // allow for a custom hit mask.
-  if (!is_translucent_ && !custom_window_region_.is_valid() &&
-      (IsFrameSystemDrawn() || !delegate_->HasNonClientView())) {
+  // Translucent windows that kept their native caption (Helium acrylic) must
+  // not get a window region: any region makes DWM drop the native caption and
+  // the system backdrop, which shows when the window is maximized.
+  const bool translucent_with_caption =
+      is_translucent_ && (window_style() & WS_CAPTION);
+  if (!custom_window_region_.is_valid() &&
+      (translucent_with_caption ||
+       (!is_translucent_ &&
+        (IsFrameSystemDrawn() || !delegate_->HasNonClientView())))) {
     if (force) {
       SetWindowRgn(hwnd(), nullptr, redraw);
     }
--- a/chrome/browser/ui/views/frame/browser_desktop_window_tree_host_win.cc
+++ b/chrome/browser/ui/views/frame/browser_desktop_window_tree_host_win.cc
@@ -378,6 +378,13 @@
     return false;
   }
 
+  // Helium acrylic: keep the glass over the whole client area in every window
+  // state, or the backdrop turns black after a maximize or resize.
+  if (helium::ShouldUseNativeFrameMaterials(browser_view_)) {
+    *insets = gfx::Insets(-1);
+    return true;
+  }
+
   // Don't extend the glass in at all if it won't be visible.
   *insets = gfx::Insets();
   return true;
